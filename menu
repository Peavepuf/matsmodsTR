        3) tani; bekle ;;
        4) mats_var_mi && { sor_mb; sor_gpu && calistir ./mats $NARGS -e "$MB"; }; bekle ;;
        5) tekrar; bekle ;;
        6) mats_var_mi && { MB=""; calistir ./mods gputest.js -oqa -test 118 -run_on_error -fan_speed 60; }; bekle ;;
